# Smartnode native-mode settings, rendered by start-node.sh on every start.
# Do not edit on the box: it is overwritten on each start.
#
# Written for Smartnode v1.24.2 (shared/services/config/*-config.go). Only the
# sections native mode reads are present; every other setting uses the
# daemon's built-in default. Values are strings, as the loader expects
# (map[string]map[string]string).
#
# root.version must equal the binary version: the daemon replays its config
# migrators in memory for any older version string.
root:
  version: ${SN_VERSION}
  isNative: "true"
  rpDir: ${SN_RP_DIR}
  executionClientMode: external
  executionClient: ${SN_EXECUTION_CLIENT}
  consensusClientMode: external
  externalConsensusClient: ${SN_CONSENSUS_CLIENT}
  useFallbackClients: "false"
  reconnectDelay: 60s
  enableMetrics: "false"
  enableODaoMetrics: "false"
  enableBitflyNodeMetrics: "false"
  enableMevBoost: "false"
  enableCommitBoost: "false"
smartnode:
  projectName: rocketpool
  network: ${SN_NETWORK}
  dataPath: ${SN_DATA_PATH}
  # Gas (gwei). manualMaxFee 0 = use the network estimate; the backend always
  # sends an explicit maxFee for transactions the owner confirms.
  # priorityFee is the tip (gwei) of the daemon's own transactions. 1 gwei, the
  # same tip the UI uses, so an automatic transaction doesn't sit in the mempool
  # and hold up the owner's transactions behind its nonce.
  manualMaxFee: "0"
  priorityFee: "1"
  # "Automatic TX Gas Threshold": the daemon's own transactions (stake,
  # auto-distribute, set-latest-delegate, express tickets, ...) wait until the
  # estimated max fee is below this. The daemon default is 150.
  minipoolStakeGasThreshold: "20"
  # Auto-distribute a minipool once its EL balance exceeds this (ETH).
  distributeThreshold: "1"
  rewardsTreeMode: download
  verifyProposals: "false"
native:
  ecHttpUrl: ${SN_EC_HTTP_URL}
  ccHttpUrl: ${SN_CC_HTTP_URL}
  consensusClient: ${SN_CONSENSUS_CLIENT}
  validatorRestartCommand: ${SN_RP_DIR}/signal-reconcile.sh
  validatorStopCommand: ${SN_RP_DIR}/signal-reconcile.sh
api:
  # HTTP API on 127.0.0.1 only; the token is in <dataPath>/api-tokens.json.
  apiPort: "${SN_API_PORT}"
  openApiPort: localhost
  tokenScope: all
  rateLimit: "0"
